# ---- Postgres (one shared instance, one database PER SERVICE — see
# postgres-init/01-create-databases.sh) ----
# The postgres container itself reads its password from ./secrets/postgres_password.txt
# (a Docker secret, not this env var — see docker-compose.yaml). Copy
# secrets/postgres_password.txt.example to secrets/postgres_password.txt and make sure
# its contents match POSTGRES_PASSWORD below exactly (the app services connect using
# this env var; only the Postgres container's own bootstrap uses the secret file).
POSTGRES_USER=catalogix
POSTGRES_PASSWORD=catalogix1234

# ---- RabbitMQ (checkout-svc/user-svc publish events; notification-svc consumes them) ----
RABBITMQ_USER=catalogix
RABBITMQ_PASSWORD=catalogix1234
# Management UI at http://localhost:15672 once docker compose is up.

# ---- CORS ----
# Comma-separated list of origins allowed to call the services directly.
# Only relevant if you talk to a service without going through the gateway
# (e.g. local `npm run start` dev server on Vite's default port 5173, or
# hitting a service directly on its own port for debugging). Browser
# traffic through the gateway (port 8080) is same-origin and unaffected.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- JWT ----
# Shared secret used to sign/verify tokens across every service (all nine
# containers with a JVM in them). Must be identical everywhere and at least
# 32 characters (HS256 requires a 256-bit key). Generate a real one for
# anything but local dev, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
# Access token lifetime, in milliseconds. Deliberately short — see REFRESH_TOKEN_EXPIRATION_MS.
JWT_EXPIRATION_MS=900000
# Refresh token lifetime, in milliseconds (default below is 7 days). Refresh
# tokens are opaque random strings (not JWTs), stored hashed in user-svc's DB,
# and rotated on every use — see POST /users/refresh.
REFRESH_TOKEN_EXPIRATION_MS=604800000

# Comma-separated emails that are promoted to ADMIN on registration (user-svc).
ADMIN_EMAILS=admin@example.com

# ---- Inter-service URLs ----
# In docker-compose these all resolve via service DNS names and are set
# directly in docker-compose.yaml (not read from this file) — listed here
# only as a reference for running a service outside compose (e.g. from your
# IDE against everything else still running in Docker):
#   CATALOG_SVC_URL=http://localhost:8082      (checkout-svc, cart-svc -> catalog-svc)
#   INVENTORY_SVC_URL=http://localhost:8085     (catalog-svc, checkout-svc, cart-svc -> inventory-svc)
#   PROMOTIONS_SVC_URL=http://localhost:8087    (checkout-svc, cart-svc -> promotions-svc)
#   PAYMENT_SVC_URL=http://localhost:8088       (checkout-svc -> payment-svc, ONLY)
#   CART_SVC_URL=http://localhost:8086          (checkout-svc -> cart-svc)
# All of these are still plain synchronous HTTP, not events — placing an
# order needs an immediate yes/no at each step (is there stock, is the
# coupon valid, did the card get charged), which isn't a great fit for async
# messaging without a much bigger eventual-consistency rework. See
# checkout-svc's CheckoutSvc Javadoc for the saga/compensation design this
# enables instead.

# ---- Distributed tracing ----
# Every service exports traces here via OTLP; view them at
# http://localhost:16686 (Jaeger UI). Also set directly in docker-compose.yaml
# for the compose path; only needed here if running a service standalone.
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---- Notifications ----
# No service calls notification-svc directly anymore — user-svc and
# checkout-svc publish events to RabbitMQ (see above) and notification-svc
# consumes them.
# "From" address on outgoing emails. In compose these all land in Mailpit
# (http://localhost:8025) — nothing is ever actually delivered anywhere.
MAIL_FROM=noreply@catalogix.local
# Used to build links inside emails (password reset, email verification).
# Point this at wherever the gateway is actually reachable from a browser.
FRONTEND_BASE_URL=http://localhost:8080
